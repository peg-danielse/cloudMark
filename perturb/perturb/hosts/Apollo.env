# Paul's PC "Apollo": i9-14900HX, 32 CPUs, 1 socket, 1 NUMA node, one 36 MiB L3.
# P-cores: CPUs 0-15 (8 cores x 2 SMT, siblings 0-1, 2-3, ...), up to 5.6 GHz.
# E-cores: CPUs 16-31 (16 cores, no SMT, 4-core clusters share an L2), up to 4.1 GHz.
MERCURY_CPU=0          # Mercury worker (its SMT sibling, CPU 1, is the first home core)
POOL=1-28              # daemon pool incl. the load generator home: homes 1-15 (P threads) grow into 16-28 (E-cores)
GEN_CPU=28             # load generator home (E-core); must be inside POOL or Mercury refuses /start
OP_CPU=29              # orchestrator
HELPER_CPU=30          # perturb.py / placer.py / ctrlog.py
SAMPLE_CPU=31          # dsb_sample.py and the sidecar
TRACE_CPUS=31          # threadtrace; the one CPU left outside the pool
STRESS_CACHE_CPUS=16-19   # E-cluster 0: shares the single L3 with every daemon
STRESS_STREAM_CPUS=20-23  # E-cluster 1: memory bandwidth
